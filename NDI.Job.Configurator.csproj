<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NDIJobConfigurator</RootNamespace>
    <AssemblyName>NDIJobConfigurator</AssemblyName>
    <AssemblyTitle>NDI Job Configurator</AssemblyTitle>
    <Description>Discover, onboard, configure, identify, and monitor NDI devices for a production job.</Description>
    <ApplicationIcon>wwwroot\NDIJobConfigurator.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
    <Compile Remove="artifacts\**\*.cs;installer\**\*.cs;tests\**\*.cs" />
    <Content Remove="artifacts\**\*;installer\**\*;tests\**\*" />
    <None Remove="artifacts\**\*;installer\**\*;tests\**\*" />
    <Content Include="LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
